@inproceedings{lvInformerbasedAnomalyDetection2022,
	title = {Informer-based {Anomaly} {Detection} for {Internet} {TV} {Service} in {Home} {Network}},
	url = {https://ieeexplore.ieee.org/document/10066023},
	doi = {10.1109/ICCC56324.2022.10066023},
	abstract = {With more and more users watch live and on-demand content through set-top boxes, internet TV has become one of China Mobile's main home internet services. Meanwhile, the problems of video freezing and blurred screen have increasingly dominated the user complaints. Because of the large number of network elements involved in Internet TV service, traditional quality inspection methods which mainly consist of manual operation and semiautomatic procedures failed to find abnormalities quickly and accurately. In this paper, we collect set-top box active users and its alarm events through China Mobile's soft probe monitoring system and accurately detect the quality degradation abnormalities in TV service by an Informec-based model, the precision rate of anomaly detection reaches over 80 \%, and the accuracy rate reaches over 90 \%.},
	urldate = {2026-08-28},
	booktitle = {2022 {IEEE} 8th {International} {Conference} on {Computer} and {Communications} ({ICCC})},
	author = {Lv, Guosong and Wang, Jing and Wang, Xingyu and Wang, Chengsen and Chen, Xinxin and Li, Jiankun and Chen, Dewei and wu, Bo and Li, LianYuan and Yu, Wei},
	month = dec,
	year = {2022},
	keywords = {/unread, Real-time systems, anomaly detection, blurred screen, Degradation, Home automation, informer, Inspection, Internet, quality degradation, TV, TV service, video freezing, Web and internet services},
	pages = {604--609},
	file = {Full Text PDF:files/914/Lv et al. - 2022 - Informer-based Anomaly Detection for Internet TV Service in Home Network.pdf:application/pdf},
}

