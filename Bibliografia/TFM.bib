	note = {arXiv:2510.04618 [cs.LG]},
	keywords = {Computer Science - Machine Learning, /unread, Computer Science - Computation and Language, Computer Science - Artificial Intelligence},
	file = {Preprint PDF:files/853/Zhang et al. - 2026 - Agentic Context Engineering Evolving Contexts for Self-Improving Language Models.pdf:application/pdf;Snapshot:files/854/2510.html:text/html},
